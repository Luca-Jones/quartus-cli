q-help() {
    cat <<EOF
quartus-cli $VERSION - Quartus Prime Lite CLI wrapper for FPGA development

Usage: quartus-cli [command] [options]

Commands:
build			Synthesize, fit, assemble, and run timing analysis
flash			Program the FPGA board over JTAG

Options:
-v | --version		Displays the verision of Quartus being used
-h | --help		Displays this help message 
-p			Force persistent programming when used with the flash command
EOF
}

q-config() {
	PROJECT_NAME="$(basename $(pwd))"
	[ -f quartus.conf ] && eval "$(sed 's/ *= */=/' quartus.conf)"
	case "$BOARD" in
	"MAX 10 DE10 - Lite")
		FAMILY="MAX 10"
		DEVICE="10M50DAF484C6GES"
		;;
	*)
		echo "Unknown board: $BOARD"
		;;
	esac
}

