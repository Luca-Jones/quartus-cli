# Description:  																										#
#			A tool for building and flashing Intel FPGA designs from the command line!									#
#																														#
# Commands:																												#
#			build compiles the project into a binary that is ready to flash onto the board								#
#			flash programs the board with the compiled binary															#
#																														#
# Instructions:																											#
#			Make sure to have Quartus 25.1 installed on your system as well additional packages that may 				#
#			be needed to support your particular board. This file must be set as executable.							#
#			The project name as well as the default top-level entity name are inherited from this project 				#
#			directory. The script searches for any nested VHDL .vdh source files within the top-level 					#
#			directory, so feel free to organize them as you wish. However, you may still need to specify 				#
# 			the top-level entity name if it is not the same as the project's name. The top-level entity 				#
#			is defined in one of your VHDL	files and serves as the project's entrypoint. Configuration 				#
#			options can be written to quartus.conf and an example is provided in the repository.						#
# 																 														#
# General workflow:						 										 										#	
#		 	1. make the project directory																				#
# 			2. source the quartus.sh file in your shell	(make sure it is executable)									#
#			3. make your source files and declare at least the top-level entity											#
#			4. modify the config options to your needs either here or in quartus.conf									#
#			5. quartus-cli build																						#
#			6. quartus-cli flash																						#
# 																 														#
# Supported Boards:																										#
#			"MAX 10 DE10 - Lite"		 																				#
# 																 														#
# Author: 																												#
# 			Luca Jones																									#
#					 																									#
#########################################################################################################################
VERSION="25.1"
case "$(uname -s)" in
    Linux)   QUARTUS_BIN="/opt/intelFPGA/${VERSION}/quartus/bin" ;;
    MINGW*|MSYS*|CYGWIN*)  QUARTUS_BIN="/c/altera_lite/${VERSION}std/quartus/bin64" ;;
    *)       echo "Unsupported OS" >&2; exit 1 ;;
esac
export PATH="$PATH:$QUARTUS_BIN"

#########################################################################################################
#                                            DEFAULTS                                                   #
#########################################################################################################
BOARD="MAX 10 DE10 - Lite"
OUT_DIR="output_files"		 # quartus-prime defaults to output_files, but you can set it to whatever
TOP_LEVEL_ENTITY=""		 	 # one of your VHDL files must have this entity defined in it
PERSISTENT_PROGRAMMING=true  # the board will remember the program after losing power if set to true
PROJECT_NAME="" 			 # will become the project directory name once q-build is run

RED="\033[0;31m"
GREEN="\033[0;32m"
NC="\033[0m"

