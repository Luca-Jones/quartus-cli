spin() {
	local pid=$1
	local chars='|/-\'
	local i=0
	printf "  "
	while kill -0 "$pid" 2>/dev/null; do
		printf "\b%s" "${chars:$((i%4)):1}"
		i=$((i+1))
		sleep 0.1
	done
	printf "\b"
}

# compiles the fpga project and generates the OUT_DIR, db, and incremental_db directories
q-build() {
	set +m
	local start

	printf "%-25s" "[1/3] Synthesis"
	start=$SECONDS
	quartus_map $PROJECT_NAME --write_settings_files=off > /dev/null 2>&1 &
	spin $!
	wait $!
	if [ $? -ne 0 ]; then
		printf "${RED}FAILED${NC}\n"
		if [ -f "$OUT_DIR/${PROJECT_NAME}.map.rpt" ]; then
			grep -E "^(Error|Warning)" "$OUT_DIR/${PROJECT_NAME}.map.rpt"
		fi
		set -m
		return 1
	fi
	printf "${GREEN}DONE${NC} (%ds)\n" "$((SECONDS - start))"

	printf "%-25s" "[2/3] Fitting"
	start=$SECONDS
	quartus_fit $PROJECT_NAME > /dev/null 2>&1 &
	spin $!
	wait $!
	printf "${GREEN}DONE${NC} (%ds)\n" "$((SECONDS - start))"

	printf "%-25s" "[3/3] Assembling"
	start=$SECONDS
	quartus_asm $PROJECT_NAME > /dev/null 2>&1 &
	spin $!
	wait $!
	printf "${GREEN}DONE${NC} (%ds)\n" "$((SECONDS - start))"

}

# run this after q-build to program the board
q-flash() {
	set +m
	local start=$SECONDS
	if $PERSISTENT_PROGRAMMING ; then
		printf "%-25s" "Flashing (Persistent)"
		quartus_pgm -m jtag -o "p;${OUT_DIR}/${PROJECT_NAME}.pof" > /dev/null 2>&1 &
	else
		printf "%-25s" "Flashing (Not Persistent)"
		quartus_pgm -m jtag -o "p;${OUT_DIR}/${PROJECT_NAME}.sof" > /dev/null 2>&1 &
	fi
	spin $!
	wait $!
	printf "${GREEN}DONE${NC} (%ds)\n" "$((SECONDS - start))"
	set -m
}

case "$1" in
    build)
		q-config
		q-init
        q-build
        ;;
    flash)
		q-config
		case "$2" in 
			-p)
				PERSISTENT_PROGRAMMING=true
				;;
			*)
				;;
		esac
        q-flash
        ;;
    -v | --version)
        echo "Quartus $VERSION"
        ;;
    -h | --help | "")
        q-help
        ;;
    *)
        echo "quartus-cli: unknown command '$1'" >&2
        echo "Run 'quartus-cli --help' for usage." >&2
        exit 1
        ;;
esac
